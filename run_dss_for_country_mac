#!/usr/bin/env bash
set -e

# ==============================================================================
# Dynamic Country DSS Marketing Runner for macOS / Linux
# Trains marketing compatibility model for ANY target country library and
# executes DSS decision evaluation.
#
# Usage:
#   ./run_dss_for_country_mac [COUNTRY_DIR] [COUNTRY_NAME] [COUNTRY_CODE]
#
# Examples:
#   ./run_dss_for_country_mac step5_new_country "United States" USA
#   ./run_dss_for_country_mac step5_new_country "Germany" DEU
# ==============================================================================

set -e
cd "$(dirname "$0")"

COUNTRY_DIR="${1:-step5_new_country}"
COUNTRY_NAME="${2:-United States}"
COUNTRY_CODE="${3:-USA}"

echo "================================================================================"
echo "    DYNAMIC COUNTRY DSS MARKETING EVALUATION (macOS / Linux)                    "
echo "================================================================================"
echo "Target Country : $COUNTRY_NAME ($ISO_CODE)"
echo "Image Library  : $COUNTRY_DIR"
echo "================================================================================"

# Identify Python executable
if [ -f ".venv/bin/python" ]; then
    PYTHON_EXEC=".venv/bin/python"
elif [ -n "$VIRTUAL_ENV" ]; then
    PYTHON_EXEC="python"
else
    PYTHON_EXEC="python3"
fi

# 1. Train Country Model with YOLOv8 + OpenCV Multi-Stage Exclusions
echo ""
echo ">>> [1/4] Training Model for $COUNTRY_NAME using $COUNTRY_DIR..."
"$PYTHON_EXEC" step4_learn/train_marketing_model.py \
    --country-dir "$COUNTRY_DIR" \
    --country-name "$COUNTRY_NAME" \
    --iso-code "$ISO_CODE"

# 2. Run DSS Marketing Decision Engine
echo ""
echo ">>> [2/4] Executing DSS Marketing Decision Engine..."
"$PYTHON_EXEC" step5_dss/dss_decision_engine.py

# 3. Generate DSS Executive Summary Analysis
echo ""
echo ">>> [3/4] Compiling DSS Summary Analysis..."
"$PYTHON_EXEC" step5_dss/dss_analysis.py

# 4. Generate Interactive Capstone Web Report
echo ""
echo ">>> [4/4] Updating Executive Web Report (CAPSTONE_REPORT.html)..."
"$PYTHON_EXEC" build_capstone_report.py

echo ""
echo "================================================================================"
echo "✓ DSS RUN FOR '$COUNTRY_NAME' COMPLETED SUCCESSFULLY!"
echo "  - Trained Model : step4_learn/market_model.pkl"
echo "  - Market Profile: step4_learn/market_profile.json"
echo "  - Approved SKUs : step5_dss/result_good_for_new_marketing.csv"
echo "  - Excluded SKUs : step5_dss/result_not_good_for_new_marketing.csv"
echo "  - Master DSS CSV: step5_dss/result5.csv"
echo "  - Web Dashboard : CAPSTONE_REPORT.html"
echo "================================================================================"
